       "command": "%sql WITH q AS (SELECT propensity_score, COUNT(*) AS num_customers\nFROM analytics_ml.int_features.propensity_scores_segmented\nGROUP BY propensity_score\nORDER BY propensity_score) ,min_max AS (SELECT `propensity_score`,(SELECT MAX(`propensity_score`) FROM q) `target_column_max`,(SELECT MIN(`propensity_score`) FROM q) `target_column_min` FROM q) ,histogram_meta AS (SELECT `propensity_score`,`target_column_min` `min_value`,IF(`target_column_max` = `target_column_min`,`target_column_max` + 1,`target_column_max`) `max_value`,(`target_column_max` - `target_column_min`) / 10 `step` FROM min_max) SELECT IF(ISNULL(`propensity_score`),NULL,LEAST(WIDTH_BUCKET(`propensity_score`,`min_value`,`max_value`,10),10)) `propensity_score_BIN`,FIRST(`min_value` + ((IF(ISNULL(`propensity_score`),NULL,LEAST(WIDTH_BUCKET(`propensity_score`,`min_value`,`max_value`,10),10)) - 1) * `step`)) `propensity_score_BIN_LOWER_BOUND`,FIRST(`step`) `propensity_score_BIN_STEP`,COUNT(`propensity_score`) `COUNT` FROM histogram_meta GROUP BY `propensity_score_BIN`",
